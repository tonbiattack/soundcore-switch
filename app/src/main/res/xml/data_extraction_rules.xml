<?xml version="1.0" encoding="utf-8"?>
<!--
    バックアップと端末間転送の制御。
    仕様書 §6「端末識別子・ペアリング情報を外部送信しない」に合わせ、
    クラウドバックアップも端末間転送も行わない。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
