<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Bluetooth 権限は Android バージョン別に最小限で要求する（仕様書 §6）。
        Android 12 (API 31) 以降は BLUETOOTH_CONNECT / BLUETOOTH_SCAN、
        それ未満は BLUETOOTH / BLUETOOTH_ADMIN を使う。
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 位置情報目的では使わないため neverForLocation を付ける。 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Bluetooth 非対応端末でもインストールできるようにする。 -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!--
        仕様書 §6「端末識別子・ペアリング情報を外部送信しない」ため、
        INTERNET 権限は意図的に宣言しない。
    -->
    <application
        android:name=".SoundcoreSwitchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SoundcoreSwitch">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SoundcoreSwitch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
